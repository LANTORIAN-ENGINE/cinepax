# ─── Veezi / Connect API ──────────────────────────────────────────────────────
VEEZI_TOKEN=
CONNECT_TENANT=
CONNECT_TOKEN=

# ─── Traduction des synopsis (Gemini) ─────────────────────────────────────────
# Clé créée sur https://aistudio.google.com/apikey — palier gratuit, sans carte.
# Absente : le site affiche le synopsis Veezi d'origine, sans traduction.
GEMINI_API_KEY=
# Modèle. Par défaut gemini-3.6-flash ; gemini-3.1-flash-lite est plus rapide.
GEMINI_MODEL=
# Secret du cron Vercel (/api/synopsis/refresh). Vide en local = route ouverte.
CRON_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# ─── BNI Pay Classic ──────────────────────────────────────────────────────────
# Credentials fournis par la BNI Madagascar
BNI_PAY_USERNAME=
BNI_PAY_PASSWORD=
BNI_PAY_ID_MERCHANT=
BNI_PAY_ID_ENTITY=
BNI_PAY_ID_OPERATOR=
BNI_PAY_OPERATOR_PASSWORD=
# Clés de décryptage du callback IMN (fournies par BNI)
BNI_PAY_SALT=
BNI_PAY_CIPHER_KEY=
# URL publique de l'app (utilisée pour la redirection après paiement)
# Ex: https://cinepax.vercel.app
NEXT_PUBLIC_APP_URL=
